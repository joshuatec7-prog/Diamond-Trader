# CryptoBot Fresh v1 - PAPER ONLY
MARKETS=BTC-EUR,ETH-EUR,SOL-EUR
CANDLE_INTERVAL=15m
POLL_SECONDS=60
CANDLE_LIMIT=500
MAX_ENTRY_DELAY_SECONDS=180
MAX_CONSECUTIVE_FAILED_CYCLES=5

# Lokaal kun je DB_PATH leeg laten; op Render wordt /var/data gebruikt indien beschikbaar.
# DB_PATH=/var/data/cryptobot_fresh.db

PAPER_START_EUR=1000
STAKE_EUR=100
MAX_OPEN_POSITIONS=2

# Conservatief kostenmodel voor EUR-markten.
TAKER_FEE_PCT=0.25
SLIPPAGE_PCT=0.05
MAX_SPREAD_PCT=0.30
BACKTEST_ASSUMED_SPREAD_PCT=0.10

EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
ATR_PERIOD=14
BREAKOUT_LOOKBACK=20
VOLUME_LOOKBACK=20
MIN_VOLUME_RATIO=1.10
RSI_MIN=52
RSI_MAX=72

STOP_ATR_MULT=1.6
TAKE_ATR_MULT=2.8
TRAILING_TRIGGER_ATR=1.6
TRAILING_DISTANCE_ATR=1.1

REQUEST_TIMEOUT_SECONDS=10
REQUEST_RETRIES=3
LOG_LEVEL=INFO
LOOP_ENABLED=true
