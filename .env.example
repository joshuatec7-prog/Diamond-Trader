RUN_MODE=PAPER
QUOTE_CURRENCY=EUR
UNIVERSE_SIZE=3
CANDLE_INTERVAL=1h
CANDLE_LIMIT=240
POLL_SECONDS=120
DEGRADED_RETRY_SECONDS=300
MAX_SIGNAL_AGE_SECONDS=900
MAX_CONSECUTIVE_FAILED_CYCLES=5

PAPER_START_EUR=5000
POSITION_EUR=200
MAX_OPEN_POSITIONS=1

TAKER_FEE_PCT=0.25
SLIPPAGE_PCT=0.08
MAX_SPREAD_PCT=0.40
BACKTEST_ASSUMED_SPREAD_PCT=0.12

BAND_WINDOW=20
BAND_STDDEV=2.0
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=2.5
MAX_HOLD_BARS=24

EVAL_MIN_TRADES=40
EVAL_MIN_SPAN_DAYS=14
EVAL_MIN_PROFIT_FACTOR=1.25
EVAL_MAX_DRAWDOWN_PCT=10

REQUEST_TIMEOUT_SECONDS=10
REQUEST_RETRIES=3
LOG_LEVEL=INFO
LOOP_ENABLED=true

# CryptoBot v4: langzame, prospectieve BTC/ETH-schaduwtest. Nooit orders.
V4_RESEARCH_POLL_SECONDS=21600
V4_VOLATILITY_LIMIT_PCT=80
V4_SLIPPAGE_BUFFER_PCT=0.05
V4_RESEARCH_REPORT_PATH=
V4_RESEARCH_DB_PATH=

# Fundingmonitor v4 bewaart maximaal 100 dagen publieke uitvoerbare L2-snapshots.
# De standaard schaduworder is $200 per leg. Cross-exchange kanslabels zijn in code fail-closed.
FUNDING_MONITOR_POLL_SECONDS=900
FUNDING_SHADOW_NOTIONAL_USD=200
FUNDING_MONITOR_REPORT_PATH=
FUNDING_MONITOR_DB_PATH=
KRAKEN_NATIVE_HOLDINGS=BTC,ETH

# Optioneel: publiceer alleen het uurlijkse PAPER-researchrapport naar GitHub
# issue #3. De token zelf hoort uitsluitend in Render en heeft alleen
# Issues: Read and write nodig; geen Contents/code-schrijfrecht.
RESEARCH_GITHUB_TOKEN=
RESEARCH_GITHUB_REPOSITORY=joshuatec7-prog/Diamond-Trader
RESEARCH_GITHUB_ISSUE=3

