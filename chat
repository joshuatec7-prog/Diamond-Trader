#!/usr/bin/env bash
# Diamond Trader cockpit v2.3
# Compacte read-only status voor Render Shell.

set -u

ROOT="/opt/render/project/src"
DATA="/var/data"
cd "$ROOT" || exit 1

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

readiness="$tmpdir/readiness.txt"
gate="$tmpdir/gate.txt"
regime="$tmpdir/regime.txt"
safety="$tmpdir/safety.txt"

python3 diamond_release_go_live_readiness.py >"$readiness" 2>&1 || true
python3 diamond_decision_gate_v1_4.py >"$gate" 2>&1 || true
python3 scanner_regime_shadow_lab.py >"$regime" 2>&1 || true

if [ -f "$DATA/diamond_safety_recovery_shadow.py" ]; then
    python3 "$DATA/diamond_safety_recovery_shadow.py" >"$safety" 2>&1 || true
fi

echo
printf '\033[1;31m============================================================\033[0m\n'
printf '\033[1;31mPLAK VANAF HIER\033[0m\n'
printf '\033[1;31m============================================================\033[0m\n'
echo "=== BEGIN DIAMOND TRADER COCKPIT ==="
echo " $(date)"
echo

echo
echo "=== HOOFDSTATUS ==="
grep -m1 '^\[PASS\] SELECTIVE' "$readiness" 2>/dev/null || \
    echo "[WAIT] SELECTIVE | status niet gevonden"

grep -m1 '^\[\(PASS\|WAIT\|REVIEW\|FAIL\)\] Execution BASELINE' "$readiness" 2>/dev/null || \
    echo "[WAIT] Execution BASELINE | status niet gevonden"

grep -m1 '^\[\(PASS\|WAIT\)\] Safety / Recovery' "$readiness" 2>/dev/null || \
    echo "[WAIT] Safety / Recovery | status niet gevonden"

grep -E '^PAPER READY|^CANARY READY|^LIVE ACTIVE' "$readiness" 2>/dev/null || true

echo
echo "=== PRE-CANARY ==="
phase_status="$DATA/diamond_release_phase_status.json"
if [ -s "$phase_status" ]; then
    python3 - "$phase_status" <<'PY_PRECANARY'
import json
import sys

path = sys.argv[1]
try:
    with open(path, "r", encoding="utf-8") as file:
        data = json.load(file)
except Exception:
    print("Pre-canary status niet leesbaar")
    raise SystemExit(0)


def yn(value):
    return "PASS" if bool(value) else "WAIT"


def yes_no(value):
    return "JA" if bool(value) else "NEE"

execution_closed = int(data.get("execution_closed") or 0)
execution_status = str(data.get("execution_status") or "WAIT")
safety_passed = int(data.get("safety_passed") or 0)
safety_total = int(data.get("safety_total") or 0)
matrix_passed = int(data.get("pre_canary_matrix_passed") or 0)
matrix_total = int(data.get("pre_canary_matrix_total") or 16)

print(f"Execution     : {execution_closed}/20 [{execution_status}]")
print(f"Safety        : {safety_passed}/{safety_total}")
print(f"BUY recovery  : {yn(data.get('buy_recovery_ready'))}")
print(f"SELL recovery : {yn(data.get('sell_recovery_ready'))}")
print(f"Canary logging: {yn(data.get('canary_logging_ready'))}")
print(f"Slippage      : {yn(data.get('slippage_status_ready'))}")
print(f"Safety matrix : {matrix_passed}/{matrix_total} {'PASS' if data.get('pre_canary_matrix_ready') else 'WAIT'}")
print(f"Pending orders: {int(data.get('pending_orders') or 0)}")
print(f"Recovery nodig: {yes_no(data.get('recovery_required'))}")
print(f"CANARY READY  : {yes_no(data.get('canary_ready'))}")
print(f"LIVE ACTIVE   : {yes_no(data.get('live_active'))}")
PY_PRECANARY
else
    echo "Pre-canary status niet beschikbaar"
fi

echo
echo "=== CANARY LIVE ==="

# Werk de canary-analyse veilig bij wanneer de helper beschikbaar is.
if [ -f "$ROOT/diamond_canary_log_analyzer.py" ]; then
    python3 "$ROOT/diamond_canary_log_analyzer.py" >/dev/null 2>&1 || true
fi

# Werk de live safety-status veilig bij wanneer de helper beschikbaar is.
if [ -f "$ROOT/diamond_live_safety_monitor.py" ]; then
    python3 "$ROOT/diamond_live_safety_monitor.py" >/dev/null 2>&1 || true
fi

canary_analysis="$DATA/diamond_canary_log_analysis.json"
live_safety="$DATA/diamond_live_safety_status.json"

python3 - "$canary_analysis" "$live_safety" <<'PY_CANARYLIVE'
import json
import math
import os
import sys

analysis_path = sys.argv[1]
safety_path = sys.argv[2]


def load(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def f(value, default=0.0):
    try:
        value = float(value)
        return value if math.isfinite(value) else default
    except Exception:
        return default


def i(value, default=0):
    try:
        return int(float(value))
    except Exception:
        return default


def eur(value):
    value = f(value)
    sign = "+" if value > 0 else ""
    return f"€{sign}{value:.4f}"


def pct(value):
    value = f(value)
    sign = "+" if value > 0 else ""
    return f"{sign}{value:.4f}%"


def pf_text(value):
    if value is None:
        return "n/a"
    try:
        value = float(value)
    except Exception:
        return "n/a"
    if math.isinf(value):
        return "INF"
    return f"{value:.4f}"


analysis = load(analysis_path)
safety = load(safety_path)

closed = i(analysis.get("closed_trades"), 0)
wins = i(analysis.get("wins"), 0)
losses = i(analysis.get("losses"), 0)
breakeven = i(analysis.get("breakeven"), 0)

if closed < 5:
    target = 5
elif closed < 10:
    target = 10
else:
    target = 10

analysis_status = str(
    analysis.get("status")
    or ("READY" if closed == 0 else "OK")
).upper()

safety_status = str(
    safety.get("status")
    or ("READY" if closed == 0 else "ONBEKEND")
).upper()

print(
    f"Canary trades : {closed}/{target} "
    f"[{analysis_status}]"
)
print(
    f"W/L/BE        : {wins}/{losses}/{breakeven}"
)
print(
    f"Live PnL      : {eur(analysis.get('actual_net_pnl_quote'))}"
)
print(
    f"PF            : {pf_text(analysis.get('profit_factor'))}"
)
print(
    f"Fees          : {eur(analysis.get('total_fees_quote'))}"
)
print(
    "Gem slippage  : "
    f"BUY {pct(analysis.get('avg_buy_slippage_pct'))} | "
    f"SELL {pct(analysis.get('avg_sell_slippage_pct'))}"
)
print(
    f"Max slippage  : {pct(analysis.get('max_adverse_slippage_pct'))}"
)
print(
    f"Execution diff: {eur(analysis.get('pnl_difference_quote'))}"
)
print(
    f"Live safety   : {safety_status}"
)

if closed == 0:
    print("Mijlpaal      : wacht op echte canary trade 1")
elif closed < 5:
    print(f"Mijlpaal      : trade {closed}/5 | fase 1 loopt")
elif closed < 10:
    print(f"Mijlpaal      : 5 bereikt | trade {closed}/10")
else:
    print("Mijlpaal      : 10/10 bereikt | handmatige review")

flags = safety.get("safety_flags") or []
if flags:
    print("Safety flags  : " + " | ".join(str(x) for x in flags[:3]))
else:
    print("Safety flags  : geen")
PY_CANARYLIVE

echo
echo "=== BELANGRIJKSTE BLOKKER ==="
exec_line="$(grep -m1 '^\[\(PASS\|WAIT\|REVIEW\|FAIL\)\] Execution BASELINE' "$readiness" 2>/dev/null || true)"
if echo "$exec_line" | grep -q '^\[PASS\]'; then
    echo "Execution: PASS - controleer overige canary-gates"
elif [ -n "$exec_line" ]; then
    echo "$exec_line"
else
    echo "Execution-status niet gevonden"
fi

echo
echo "=== RESEARCH COMPACT ==="

long_line="$(awk '
/LONG QUALITY/{on=1; next}
/SHORT QUALITY/{on=0}
on && /ALL_ELIGIBLE/ {line=$0}
END{print line}
' "$gate" 2>/dev/null)"
[ -n "$long_line" ] && echo "LONG  : $long_line" || echo "LONG  : geen status"

short_line="$(awk '
/SHORT QUALITY/{on=1; next}
/REGIME SHADOW/{on=0}
on && /ALL_ELIGIBLE/ {line=$0}
END{print line}
' "$gate" 2>/dev/null)"
[ -n "$short_line" ] && echo "SHORT : $short_line" || echo "SHORT : geen status"

btc_line="$(grep -m1 '^\[\(PASS\|WAIT\|REVIEW\|FAIL\)\] BTC Event Confirmation' "$readiness" 2>/dev/null || true)"
[ -n "$btc_line" ] && echo "BTC EVT: $btc_line"

echo
echo "=== REGIME ==="
grep -E '^(CURRENT|COMPRESSION|BTC_ALIGNED|BTC_OPPOSITE)[[:space:]]' "$regime" 2>/dev/null || \
    echo "Geen regime-status"

echo
echo "=== SYSTEEM ==="
runner_line="$(grep -m1 'Periodic runner' "$gate" 2>/dev/null || true)"
[ -n "$runner_line" ] && echo "$runner_line" || echo "Periodic runner: status niet gevonden"

for proc in \
    "agent.py" \
    "supervisor_agent.py" \
    "closed_candle_runner.py" \
    "periodic_analysis_runner.py"
do
    if pgrep -f "$proc" >/dev/null 2>&1; then
        printf "OK   %s\n" "$proc"
    else
        printf "FOUT %s\n" "$proc"
    fi
done

echo
echo "=== SAFETY DETAIL ==="
if [ -s "$safety" ]; then
    grep -E '^(PASS|MISSING|WARNING)[[:space:]]' "$safety" 2>/dev/null || true
    grep -E '^(Ontbrekend|Warnings|Orders|Private API)' "$safety" 2>/dev/null || true
else
    echo "Safety detail niet beschikbaar"
fi

echo
echo " Alleen lezen | Geen orders | Geen live/config wijziging"
printf '\033[1;31m============================================================\033[0m\n'
printf '\033[1;31mEINDE DIAMOND TRADER COCKPIT\033[0m\n'
printf '\033[1;31m============================================================\033[0m\n'
