import json
import math
import sys

analysis_path = sys.argv[1]
safety_path = sys.argv[2]


def load(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def f(value, default=0.0):
    try:
        value = float(value)
        return value if math.isfinite(value) else default
    except Exception:
        return default


def i(value, default=0):
    try:
        return int(float(value))
    except Exception:
        return default


def eur(value):
    value = f(value)
    sign = "+" if value > 0 else ""
    return f"€{sign}{value:.4f}"


def pct(value):
    value = f(value)
    sign = "+" if value > 0 else ""
    return f"{sign}{value:.4f}%"


def pf_text(value):
    if value is None:
        return "n/a"
    try:
        value = float(value)
    except Exception:
        return "n/a"
    if math.isinf(value):
        return "INF"
    return f"{value:.4f}"


analysis = load(analysis_path)
safety = load(safety_path)

