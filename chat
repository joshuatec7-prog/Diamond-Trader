import json
import math
import sys

path = sys.argv[1]

try:
    with open(path, "r", encoding="utf-8") as handle:
        data = json.load(handle)
    if not isinstance(data, dict):
        data = {}
except Exception:
    data = {}

summary = data.get("summary") or {}
by_status = summary.get("by_fusion_status") or {}

def cp(status, horizon):
    row = by_status.get(status) or {}
    checkpoints = row.get("checkpoints") or {}
    item = checkpoints.get(horizon) or {}
    try:
        n = int(item.get("n") or 0)
    except Exception:
        n = 0
    avg = item.get("average_return_pct")
    if n == 0 or avg is None:
        return "n=0"
    try:
        avg = float(avg)
    except Exception:
        return f"n={n}"
    return f"n={n} avg={avg:+.2f}%"

if not data:
    print("Outcome data : WAIT_DATA")
else:
    print(
        "Events       : "
        f"{int(summary.get('events_total') or 0)} totaal | "
        f"nieuw {int(data.get('events_created_now') or 0)} | "
        f"checks {int(data.get('checkpoints_completed_now') or 0)}"
    )

    labels = [
        ("FUSED", "FUSED"),
        ("CONFLICT", "FUSED_CONFLICT"),
        ("NEWS", "NEWS_WATCH"),
        ("MARKET", "MARKET_WATCH"),
    ]
    for label, status in labels:
        row = by_status.get(status) or {}
        events = int(row.get("events") or 0)
        print(
            f"{label:<8} : "
            f"events={events:<3} | "
            f"1h {cp(status,'1h')} | "
            f"4h {cp(status,'4h')} | "
            f"12h {cp(status,'12h')}"
        )

